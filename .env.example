# ---- Default: Groq (free API for open-source models) ------------------------
# Create a free key (no credit card) at https://console.groq.com/keys
GNANI_LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
# GNANI_MODEL=openai/gpt-oss-120b        # optional: any chat model listed on Groq

# ---- Alternative: Ollama (runs an open-source model locally, no key) ----------
# 1) install https://ollama.com   2) ollama pull qwen2.5:7b   3) use:
# GNANI_LLM_PROVIDER=ollama
# GNANI_MODEL=qwen2.5:7b

# ---- Alternative: Claude --------------------------------------------------------
# GNANI_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# GNANI_MODEL=claude-opus-5-5
